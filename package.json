{
  "name": "dynamic-drag-drop-dashboard",
  "version": "0.1.1",
  "description": "A unified Home Assistant integration for building dynamic drag-and-drop dashboards.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "esbuild src/drag-and-drop-card.js --bundle --minify --format=esm --target=es2019 --outfile=custom_components/dynamic_drag_drop_dashboard/frontend/dynamic-drag-drop-dashboard.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "test": "node --test",
    "watch": "npm run build -- --watch",
    "ha:start": "./scripts/ha-dev.sh start",
    "ha:stop": "./scripts/ha-dev.sh stop",
    "ha:restart": "./scripts/ha-dev.sh restart",
    "ha:logs": "./scripts/ha-dev.sh logs"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "esbuild": "^0.25.9"
  },
  "dependencies": {
    "interactjs": "^1.10.27",
    "js-yaml": "^4.1.0"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tlamoureux24/dynamic-drag-drop-dashboard.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/tlamoureux24/dynamic-drag-drop-dashboard/issues"
  },
  "homepage": "https://github.com/tlamoureux24/dynamic-drag-drop-dashboard#readme"
  
}
